{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" ballast-principles",
            "timeout": 10,
            "statusMessage": "Injecting ballast principles..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" dev-process-nudge",
            "timeout": 15,
            "statusMessage": "Checking for leftover project processes..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" origin-sweep",
            "timeout": 20,
            "statusMessage": "Reaping orphaned visual origins..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" freehand-mode",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" askuserquestion-recommend",
            "timeout": 5,
            "statusMessage": "Checking AskUserQuestion (Recommended) label..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" shell-guards",
            "timeout": 5,
            "statusMessage": "Checking shell command guards..."
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" diff-review-cap",
            "timeout": 5,
            "statusMessage": "Checking diff-review leaf caps..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" visual-arm",
            "timeout": 5,
            "statusMessage": "Checking for frontend touch (visual arming)..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" plan-handoff",
            "timeout": 5,
            "statusMessage": "Injecting plan-handoff pointer..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" inline-churn-nudge",
            "timeout": 5,
            "statusMessage": "Counting in-line edit run..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" mode-state-cleanup",
            "timeout": 10,
            "statusMessage": "Clearing statusline mode state..."
          }
        ]
      }
    ]
  }
}
