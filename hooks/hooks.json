{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" ballast-principles",
            "timeout": 10,
            "statusMessage": "Injecting ballast principles..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" harness-sweep-nudge",
            "timeout": 10,
            "statusMessage": "Checking for unswept postmortem reports..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" dev-process-nudge",
            "timeout": 15,
            "statusMessage": "Checking for leftover project processes..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" origin-sweep",
            "timeout": 20,
            "statusMessage": "Reaping orphaned visual origins..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" freehand-mode",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" subagent-fanout",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" askuserquestion-recommend",
            "timeout": 5,
            "statusMessage": "Checking AskUserQuestion (Recommended) label..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" process-lifecycle-guard",
            "timeout": 5,
            "statusMessage": "Checking sub-agent process lifecycle..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" package-install-guard",
            "timeout": 5,
            "statusMessage": "Checking for package installs / npx..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" git-commit-guard",
            "timeout": 5,
            "statusMessage": "Checking git commit / staging hygiene..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" commit-review-gate",
            "timeout": 10,
            "statusMessage": "Checking review-gated commit (shadow)..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" ballast-allow",
            "timeout": 5,
            "statusMessage": "Checking permission allowlist..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" doc-write-guard",
            "timeout": 10,
            "statusMessage": "Checking durable-doc authoring gate (permanent-tier)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" doc-write-guard",
            "timeout": 10,
            "statusMessage": "Checking durable-doc altitude (overfit guard)..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" plan-authoring",
            "timeout": 5,
            "statusMessage": "Checking for plan-file authoring..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" visual-arm",
            "timeout": 5,
            "statusMessage": "Checking for frontend touch (visual arming)..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" plan-handoff",
            "timeout": 5,
            "statusMessage": "Injecting plan→execution handoff protocol..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" inline-churn-nudge",
            "timeout": 5,
            "statusMessage": "Logging inline-edit run length (shadow)..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" mode-state-cleanup",
            "timeout": 10,
            "statusMessage": "Clearing statusline mode state..."
          }
        ]
      }
    ]
  }
}
