#!/usr/bin/env bash
# Stable, cross-OS entry point for session-postmortem's extract.py.
#
# This file lives in plugins/ballast/bin/, which Claude Code puts on PATH
# for any Bash tool call while the ballast plugin is enabled. That makes
# "ballast-extract" a bare, machine-independent literal — both the
# session-postmortem SKILL.md docs and the ballast-allow.py self-allow hook
# key off this exact name, so it must never be invoked through a wrapper,
# alias, or path prefix (see SKILL.md's Common-mistakes entry).
#
# Extensionless + a bash shebang: Claude Code's plugin bin/ mechanism invokes
# files here directly (no .sh/.py extension), and Git Bash (a Claude Code
# prerequisite on Windows) resolves #!/usr/bin/env bash on every OS we target.

set -euo pipefail

# Resolve our own directory even if invoked via a relative path or symlink,
# so the extract.py reference below is robust regardless of caller cwd.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$DIR/_python-probe.sh"

# exec (not a subshell call) so this wrapper doesn't linger as an extra
# process layer, and so extract.py's exit code / signals propagate untouched.
exec "${PY[@]}" "$DIR/../skills/session-postmortem/scripts/extract.py" "$@"
