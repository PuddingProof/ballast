#!/usr/bin/env bash
# Stable, cross-OS entry point for the visual-stack ORIGIN LEDGER CLI
# (hooks/visual_origin_ledger.py). Subcommands: record | list | teardown.
#
# This file lives in plugins/ballast/bin/, which Claude Code puts on PATH for
# any Bash tool call while the ballast plugin is enabled — so the orchestrator
# invokes it as the bare, machine-independent literal "ballast-visual-origin".
#
#   ballast-visual-origin record   --transcript-path <p> --url <u> --out-dir <d> --pid <n>
#   ballast-visual-origin list     --transcript-path <p> | --all
#   ballast-visual-origin teardown --transcript-path <p>
#
# ONE shim with subcommands rather than one per verb, deliberately: record and
# teardown read and write the SAME on-disk format, and a second entry point is a
# second place for that format to drift. --session-key is accepted anywhere
# --transcript-path is.
#
# Extensionless + a bash shebang: Claude Code's plugin bin/ mechanism invokes
# files here directly (no .sh/.py extension), and Git Bash (a Claude Code
# prerequisite on Windows) resolves #!/usr/bin/env bash on every OS we target.

set -euo pipefail

# Resolve our own directory even if invoked via a relative path or symlink, so
# the library reference below is robust regardless of caller cwd.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Interpreter resolution: never assume `python` vs `python3` exists, and never trust a name on
# PATH to be a real interpreter. Probe candidates in order and verify each ACTUALLY runs. This is
# ballast-extract's probe verbatim — same hazard, same two complementary defenses:
#
#   1. TIMEOUT — `.../WindowsApps/python3` is an App-Execution-Alias that does NOT exit non-zero
#      when run non-interactively: it HANGS, blocking on a Store UI a headless shell can never
#      satisfy. A hang is strictly worse than a failure (it wedges the caller instead of falling
#      through), so every probe execution is bounded. `timeout` is coreutils — present in Git Bash
#      and on Linux, absent on stock macOS, which is why defense 2 is not redundant.
#   2. TWO-PASS path RESOLUTION — pass 1 probes the first PATH hit that is NOT an alias; pass 2
#      retries by bare name only if nothing real resolved, so a genuine Store-installed Python
#      still works. Resolving rather than skipping matters because the common Windows PATH layout
#      puts the alias AHEAD of a real install.
if command -v timeout >/dev/null 2>&1; then PROBE=(timeout 5); else PROBE=(); fi

PY=()
for pass in skip-stubs allow-stubs; do
  for candidate in "python3" "python" "py -3"; do
    read -r -a cand_parts <<<"$candidate"
    if [ "$pass" = "skip-stubs" ]; then
      real="$(type -aP "${cand_parts[0]}" 2>/dev/null | grep -iv windowsapps | head -1 || true)"
      [ -z "$real" ] && continue
      cand_parts[0]="$real"
    fi
    if ${PROBE[@]+"${PROBE[@]}"} "${cand_parts[@]}" -c 'import sys' >/dev/null 2>&1; then
      PY=("${cand_parts[@]}")
      break 2
    fi
  done
done

if [ "${#PY[@]}" -eq 0 ]; then
  echo "ballast-visual-origin: no working Python 3 found (tried python3, python, py -3)" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# ANCESTRY ANCHOR — measured, not defensive.
#
# `record` fingerprints the OWNING SESSION's process by walking this process's ancestor chain (see
# detect_owner()). On Windows that walk dead-ends one hop above this script, 8/8 in measurement:
# when an MSYS bash spawns a bash SCRIPT — exactly how a bin/ shim is invoked from the Bash tool —
# MSYS's fork emulation leaves a transient intermediate that has already EXITED by the time the
# CLI starts, and Windows keeps no record of a dead process's own parent. The chain is therefore
# unrecoverable from the Python side: `ps` launched by a NON-MSYS process (our interpreter) gets a
# fresh MSYS namespace showing only itself, so the bridge cannot live there. It has to be here.
#
# This script IS inside the original MSYS tree, so `ps -W` shows the real MSYS parentage plus the
# WINPID needed to rejoin the Win32 table. We hand the CLI the WINPID of the OUTERMOST MSYS
# ancestor (the Bash tool's own shell) as an anchor to resume the Win32 walk from. Best-effort:
# no ps, a real POSIX ps (no WINPID column), or any parse failure leaves the variable unset and
# the CLI falls back to walking from itself — which is correct everywhere the break doesn't exist.
if command -v ps >/dev/null 2>&1; then
  anchor="$(ps -W 2>/dev/null | awk -v start="$$" '
    $1 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ { ppid[$1] = $2; win[$1] = $4 }
    END {
      cur = start
      for (i = 0; i < 32; i++) {
        if (!(cur in win)) break
        last = win[cur]
        if (!(ppid[cur] in win)) break
        cur = ppid[cur]
      }
      if (last != "") print last
    }' 2>/dev/null || true)"
  case "$anchor" in
    ''|*[!0-9]*) : ;;                            # empty or non-numeric -> no anchor
    *) export BALLAST_ORIGIN_ANCHOR_PID="$anchor" ;;
  esac
fi

# exec (not a subshell call) so this wrapper doesn't linger as an extra process layer, and so the
# CLI's exit code / signals propagate untouched.
exec "${PY[@]}" "$DIR/../hooks/visual_origin_ledger.py" "$@"
